:root {
}

.header {
    font-size: 80px;
    color: rgb(255, 255, 255);
    align-self: center;
}

.Button {
    font-size: 20px;
    -unity-text-outline-color: rgb(255, 255, 255);
    width: 220px;
    height: 60px;
    align-self: center;
    background-color: rgb(0, 255, 47);
    transition-duration: 0.35s;
}

.Button:hover {
    scale: 1.1 1.1;
    -unity-background-image-tint-color: rgb(0, 120, 18);
}
